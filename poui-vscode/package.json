{
  "name": "poui-vscode",
  "displayName": "PO-UI Specialist",
  "description": "Gera componentes Angular PO-UI integrados ao Protheus REST diretamente no VS Code, usando o Claude Code CLI já autenticado — sem API key separada.",
  "version": "0.0.1",
  "publisher": "andre-costa",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18.19.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "poui.generate.component", "title": "PO-UI: Gerar Componente" },
      { "command": "poui.generate.test", "title": "PO-UI: Gerar Teste Unitário" },
      { "command": "poui.lint", "title": "PO-UI: Lint de Componentes" },
      { "command": "poui.quality", "title": "PO-UI: Auditoria de Qualidade" },
      { "command": "poui.review", "title": "PO-UI: Revisar Código" },
      { "command": "poui.preview", "title": "PO-UI: Preview no Browser" },
      { "command": "poui.generate.e2e", "title": "PO-UI: Gerar Teste E2E (Playwright)" },
      { "command": "poui.undo", "title": "PO-UI: Reverter Componente Gerado" },
      { "command": "poui.generate.screenshot", "title": "PO-UI: Gerar a partir de Screenshot" },
      { "command": "poui.package", "title": "PO-UI: Empacotar Projeto (.app)" },
      { "command": "poui.connect", "title": "PO-UI: Conectar ao Protheus" },
      { "command": "poui.scaffold", "title": "PO-UI: Criar Novo Projeto (Scaffold)" }
    ],
    "configuration": {
      "title": "PO-UI Specialist",
      "properties": {
        "poui.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Modelo Claude usado para gerar código."
        },
        "poui.effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "default": "high",
          "description": "Nível de esforço/raciocínio do modelo."
        }
      }
    }
  },
  "scripts": {
    "sync-prompts": "node scripts/sync-prompts.mjs",
    "compile": "npm run sync-prompts && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require ts-node/register --timeout 15000 \"src/test/unit/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^11.0.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
