# Repositório de docs (repo separado, não submodule)
poui-specialist-docs/

# Projeto de testes (repo separado)
Teste_poui/

# Dependências do tooling de release
node_modules/
package-lock.json

# Build artifacts do projeto de exemplo (examples/modulo-compras)
examples/modulo-compras/dist/
examples/modulo-compras/.angular/
# package-lock.json acima ignora só o da raiz (tooling) — manter o do exemplo, para instalação reprodutível
!examples/modulo-compras/package-lock.json

# Worktrees isolados de execução de planos (superpowers)
.worktrees/

# Extensão VS Code (poui-vscode) — build/test artifacts
poui-vscode/out/
poui-vscode/.vscode-test/
poui-vscode/assets/agent-prompts/
!poui-vscode/package-lock.json
