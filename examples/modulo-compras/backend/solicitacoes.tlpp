/*/
Public Method Update(cId, cBody) Class SolicService
    Local oJson := JsonObject():New()

    // TODO: validar existencia (cId) e executar FWMVCRotAuto de alteracao
    oJson['numero'] := cId

    ::cJsonResp := oJson:ToJson()
    ::nHttpSts  := 200

Return .T.

